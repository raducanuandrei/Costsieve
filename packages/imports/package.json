{
  "name": "@costsieve/imports",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "import": "./dist/src/node.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "check:browser": "esbuild src/index.ts --bundle --platform=browser --format=esm --splitting --outdir=dist/browser"
  },
  "dependencies": {
    "@costsieve/engine": "0.1.0",
    "@napi-rs/canvas": "1.1.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/ron": "1.0.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.5.438",
    "read-excel-file": "9.3.14",
    "tesseract.js": "7.0.0"
  }
}
